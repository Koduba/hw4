# Copy to hw4/.env and fill in. Placeholders only: never commit real keys.
# Required: Portkey key for all AI calls (agent model routed through Portkey)
PORTKEY_API_KEY=your-portkey-api-key
OPENAI_MODEL=gpt-5.6-luna

# Optional
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Optional: on-model product photos (backend/generate_model_shots.py)
PORTKEY_IMAGE_DEPLOYMENT=your-azure-image-deployment-name
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-1.5
